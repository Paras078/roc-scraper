<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.roc-scraper.fetch</string>
    <key>ProgramArguments</key>
    <array>
        <!-- keep the Mac awake for the run; a missed 06:00 (asleep) runs on wake -->
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/bin/sh</string>
        <string>-c</string>
        <!-- fetch today's + overdue states; push what's new to Turso (the live site); rebuild the local copy.
             Each step runs even if the one before failed: failed states keep their previous data. -->
        <string>cd /Users/parasarora/roc-scraper; /usr/bin/python3 fetch.py; TURSO_TOKEN="$(cat /Users/parasarora/.turso_mca_rw)" /usr/bin/python3 sync_turso.py; /usr/bin/python3 build_db.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TURSO_URL</key><string>libsql://mca-paras078.aws-ap-south-1.turso.io</string>
        <!-- system roots + the office proxy's CA (Netskope re-signs HTTPS); harmless off that network -->
        <key>SSL_CERT_FILE</key><string>/Users/parasarora/.ca-bundle-with-proxy.pem</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <key>StandardOutPath</key><string>/Users/parasarora/roc-scraper/fetch.log</string>
    <key>StandardErrorPath</key><string>/Users/parasarora/roc-scraper/fetch.log</string>
</dict>
</plist>
